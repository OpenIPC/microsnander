<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MicroSNANDer" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorPrimary">@color/panel</item>
        <item name="android:colorPrimaryDark">@color/bg</item>
        <item name="android:colorAccent">@color/amber</item>
        <item name="android:textColor">@color/ink</item>
        <!-- brass check boxes and radio buttons (brass 1.4.0): their own marks, no tint, so on
             and off read the same under the D-pad focus; the focus is the amber frame -->
        <item name="android:checkboxStyle">@style/BrassCheck</item>
        <item name="android:radioButtonStyle">@style/BrassRadio</item>
    </style>
    <style name="BrassCheck" parent="android:Widget.Material.CompoundButton.CheckBox">
        <item name="android:background">@drawable/focus_ring</item>
        <item name="android:button">@drawable/brass_check</item>
        <item name="android:buttonTint">@null</item>
        <!-- 6dp between the mark and the text, and after the text for the focus frame -->
        <item name="android:paddingStart">6dp</item>
        <item name="android:paddingEnd">6dp</item>
    </style>
    <style name="BrassRadio" parent="android:Widget.Material.CompoundButton.RadioButton">
        <item name="android:background">@drawable/focus_ring</item>
        <item name="android:button">@drawable/brass_radio</item>
        <item name="android:buttonTint">@null</item>
        <!-- 6dp between the mark and the text, and after the text for the focus frame -->
        <item name="android:paddingStart">6dp</item>
        <item name="android:paddingEnd">6dp</item>
    </style>
    <style name="Brass" parent="android:Widget.Material.Button">
        <item name="android:background">@drawable/brass_button</item>
        <item name="android:textColor">@color/ink_dark</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0.15</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:layout_margin">6dp</item>
        <item name="android:focusable">true</item>
    </style>
    <!-- three buttons a row: a smaller face, so DETECT and REGISTERS in Brass Serif fit a phone -->
    <style name="Brass.Small">
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:paddingLeft">2dp</item>
        <item name="android:paddingRight">2dp</item>
        <item name="android:maxLines">1</item>
    </style>
    <style name="Plate">
        <item name="android:background">@drawable/plate</item>
        <item name="android:textColor">@color/ink_dark</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.2</item>
        <item name="android:paddingLeft">10dp</item>
        <item name="android:paddingRight">10dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
    </style>
</resources>
