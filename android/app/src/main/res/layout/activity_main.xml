<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- the name in the middle, the version number small to its right (brass 1.3.0):
             two equal side columns keep the name centred whatever the version's width -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="true"
            android:orientation="horizontal">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:letterSpacing="0.16"
                android:shadowColor="#59c9a24d"
                android:shadowRadius="16"
                android:text="@string/app_name"
                android:textAllCaps="true"
                android:textColor="@color/brass"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/version"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:paddingStart="4dp"
                android:paddingEnd="0dp"
                android:textColor="@color/dim"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:text="@string/subtitle"
            android:textColor="@color/dim"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/panel"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                style="@style/Plate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/console" />

            <!-- the board: ADAPTER, CHIP, STATE, WEB, CAMEX, a row each (Brass.Row, filled in code) -->
            <LinearLayout
                android:id="@+id/board"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/display"
                android:orientation="vertical"
                android:paddingLeft="12dp"
                android:paddingTop="9dp"
                android:paddingRight="12dp"
                android:paddingBottom="9dp" />

            <ProgressBar
                android:id="@+id/bar"
                style="@android:style/Widget.Material.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:max="100"
                android:progressTint="@color/amber"
                android:visibility="invisible" />

            <!-- the line of the event: the message of the last operation, the chip's warning -->
            <TextView
                android:id="@+id/meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="monospace"
                android:lineSpacingMultiplier="1.2"
                android:textColor="@color/dim"
                android:textSize="13sp" />

            <Button
                android:id="@+id/b_consent"
                style="@style/Brass"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:paddingLeft="24dp"
                android:paddingRight="24dp"
                android:text="@string/tunnel_consent"
                android:visibility="gone" />

            <!-- the buttons, three by three -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/b_detect"
                    style="@style/Brass.Small"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/detect" />
                <Button
                    android:id="@+id/b_read"
                    style="@style/Brass.Small"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/read" />
                <Button
                    android:id="@+id/b_erase"
                    style="@style/Brass.Small"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/erase" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/b_write"
                    style="@style/Brass.Small"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/write" />
                <Button
                    android:id="@+id/b_registers"
                    style="@style/Brass.Small"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/registers" />
                <Button
                    android:id="@+id/b_selftest"
                    style="@style/Brass.Small"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/selftest" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/b_export"
                    style="@style/Brass.Small"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:enabled="false"
                    android:text="@string/export" />
                <Button
                    android:id="@+id/b_import"
                    style="@style/Brass.Small"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/import_" />
                <Button
                    android:id="@+id/b_settings"
                    style="@style/Brass.Small"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/settings" />
            </LinearLayout>
            </LinearLayout>

            <!-- the checks under the buttons, in one row, as wide as their text -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/c_boot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/start_on_boot" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <CheckBox
                    android:id="@+id/c_log"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/show_log" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />
            </LinearLayout>
        </LinearLayout>

        <!-- the log of events, under the panel, when Show log is on -->
        <TextView
            android:id="@+id/log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/display"
            android:fontFamily="monospace"
            android:padding="12dp"
            android:textColor="@color/dim"
            android:textIsSelectable="true"
            android:textSize="11sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/regs_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/panel"
            android:orientation="vertical"
            android:padding="18dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    style="@style/Plate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/status_registers" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/regs_title"
                    style="@style/Plate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <GridLayout
                android:id="@+id/regs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:columnCount="9" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/regs_note"
                android:layout_marginTop="10dp"
                android:fontFamily="monospace"
                android:text="@string/registers_note"
                android:textColor="@color/dim"
                android:textSize="11sp" />

            <Button
                android:id="@+id/b_unprotect"
                style="@style/Brass"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:paddingLeft="24dp"
                android:paddingRight="24dp"
                android:text="@string/unprotect" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/hex_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/panel"
            android:orientation="vertical"
            android:padding="18dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    style="@style/Plate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/hex_view" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/hex_file"
                    style="@style/Plate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAllCaps="false" />
            </LinearLayout>

            <EditText
                android:id="@+id/hex_addr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/display"
                android:digits="0123456789abcdefABCDEFxX"
                android:fontFamily="monospace"
                android:hint="@string/hex_hint"
                android:imeOptions="actionGo"
                android:importantForAutofill="no"
                android:inputType="textNoSuggestions|textVisiblePassword"
                android:maxLength="14"
                android:padding="10dp"
                android:singleLine="true"
                android:textColor="@color/amber"
                android:textColorHint="@color/dim"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/b_hex_prev"
                    style="@style/Brass"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/hex_prev" />

                <Button
                    android:id="@+id/b_hex_go"
                    style="@style/Brass"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/hex_go" />

                <Button
                    android:id="@+id/b_hex_next"
                    style="@style/Brass"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/hex_next" />
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/display">

                <TextView
                    android:id="@+id/hex"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:padding="10dp"
                    android:textColor="@color/ink"
                    android:textSize="11sp"
                    android:typeface="monospace" />
            </HorizontalScrollView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="monospace"
                android:text="@string/hex_note"
                android:textColor="@color/dim"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
